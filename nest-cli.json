{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "projects": {
    "api": {
      "type": "application",
      "root": "src/api",
      "sourceRoot": "src/api",
      "entryFile": "main",
      "compilerOptions": {
        "tsConfigPath": "tsconfig.build.json"
      }
    },
    "microservice": {
      "type": "application",
      "root": "apps/analyses-kol-service",
      "sourceRoot": "apps/analyses-kol-service/src",
      "entryFile": "microservice",
      "compilerOptions": {
        "tsConfigPath": "apps/analyses-kol-service/tsconfig.json"
      }
    },
    "auth": {
      "type": "application",
      "root": "apps/auth",
      "sourceRoot": "apps/auth/src",
      "entryFile": "main",
      "compilerOptions": {
        "tsConfigPath": "apps/auth/tsconfig.json"
      }
    },
    "update-price": {
      "type": "application",
      "root": "apps/auth",
      "sourceRoot": "apps/update-price-service/src",
      "entryFile": "main",
      "compilerOptions": {
        "tsConfigPath": "apps/update-price-service/tsconfig.json"
      }
    }
  }
}
